rules_version = '2';

// Reglas de seguridad de Firestore — RutaUdeA (plan, sección 4 y 7)
// Roles: aspirante (usuario autenticado) y admin (users/{uid}.rol == "admin")
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- users ----------
    // Cada usuario lee su propio perfil; el admin puede leer todos.
    // El usuario solo puede crear su propio perfil con rol aspirante y el
    // correo de su token; no puede cambiar rol, estado, correo ni fecha de
    // creación. El admin puede cambiar roles y estados de otros usuarios.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.rol == 'aspirante'
        && request.resource.data.correo == request.auth.token.email
        && (!('estado' in request.resource.data)
          || request.resource.data.estado == 'activo');
      allow update: if (isOwner(userId) && onlyOwnFields())
        || isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- rachas ----------
    // Racha de actividad de cada usuario. El id del documento es el uid,
    // así que solo el dueño (o un admin) puede leerla y gestionarla.
    match /rachas/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if request.auth != null && isOwner(userId)
        && request.resource.data.actual is int
        && request.resource.data.actual >= 0
        && request.resource.data.mejor is int
        && request.resource.data.mejor >= 0;
      allow delete: if isAdmin();
    }

    // ---------- encuestasSatisfaccion (prueba piloto) ----------
    // Una respuesta por usuario (el id del documento es el uid): el dueño
    // la crea/actualiza y el admin lee todas para el análisis.
    match /encuestasSatisfaccion/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create, update: if request.auth != null && isOwner(userId);
      allow delete: if isAdmin();
    }

    // ---------- questions (banco maestro legacy) ----------
    // Lectura para usuarios autenticados; escritura solo admin.
    // Desde la Fase 7 la app lee `questions_v2`; esta colección queda
    // congelada para rollback (D-02 §5 y D-12).
    match /questions/{questionId} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- questions_v2 (banco canónico, contrato v2) ----------
    // La app sincroniza solo estados publicables. Escritura exclusiva
    // del admin (el ETL usa una service account fuera del cliente).
    match /questions_v2/{questionId} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- contexts_v2 (contextos compartidos, D-05) ----------
    match /contexts_v2/{contextId} {
      allow read: if request.auth != null;
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- bank_manifest (publicación del banco, D-02) ----------
    // Solo el panel publica `active`; la app solo lee.
    match /bank_manifest/{documentId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ---------- contexts ----------
    match /contexts/{contextId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ---------- components / subtopics ----------
    match /components/{componentId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /subtopics/{subtopicId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ---------- simulations / simulationQuestions ----------
    // Cada usuario crea y lee sus propios simulacros; admin lee todos
    // (indicadores de uso del banco).
    match /simulations/{simulationId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create: if request.auth != null && isOwner(request.resource.data.uid);
      allow update, delete: if false;

      match /simulationQuestions/{questionId} {
        allow read: if isAdmin() || isSimulationOwner(simulationId);
        allow create: if request.auth != null;
        allow update, delete: if false;
      }

      function isSimulationOwner(simulationId) {
        return request.auth != null
          && exists(/databases/$(database)/documents/simulations/$(simulationId))
          && get(/databases/$(database)/documents/simulations/$(simulationId)).data.uid == request.auth.uid;
      }
    }

    // ---------- practiceSessions / practiceQuestions ----------
    // Cada usuario crea y lee sus propias sesiones de práctica; admin lee
    // todos (indicadores de uso y futura analítica de progreso).
    match /practiceSessions/{sessionId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create: if request.auth != null && isOwner(request.resource.data.uid);
      allow update, delete: if false;

      match /practiceQuestions/{questionId} {
        allow read: if isAdmin() || isPracticeOwner(sessionId);
        allow create: if request.auth != null;
        allow update, delete: if false;
      }

      function isPracticeOwner(sessionId) {
        return request.auth != null
          && exists(/databases/$(database)/documents/practiceSessions/$(sessionId))
          && get(/databases/$(database)/documents/practiceSessions/$(sessionId)).data.uid == request.auth.uid;
      }
    }

    // ---------- recommendations ----------
    // Generadas por el sistema; el usuario solo las lee.
    match /recommendations/{recommendationId} {
      allow read: if isOwner(resource.data.uid) || isAdmin();
      allow create, update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------- educationalContent ----------
    match /educationalContent/{contentId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ---------- settings (reglas del simulacro) ----------
    // Solo lectura para la app; escritura desde el panel admin.
    match /settings/{settingId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ---------- helpers ----------
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.rol == 'admin';
    }

    // Campos que el dueño del perfil puede modificar por su cuenta. Quedan
    // fuera `correo`, `rol`, `estado`, `fechaCreacion` y `proveedor`.
    function onlyOwnFields() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'nombre',
          'apellido',
          'telefono',
          'ciudad',
          'institucion',
          'tipoInstitucion',
          'gradoSemestre',
          'fechaExamen',
          'fotoUrl',
          'onboardingCompletado'
        ]);
    }
  }
}
