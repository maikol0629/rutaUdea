# =============================================================================
# RutaUdeA — qué NO se versiona
#
# Regla general: los secretos y los artefactos regenerables se ignoran; el
# código, la configuración del proyecto, el wrapper de Gradle y los scripts
# de migración sí se versionan.
# =============================================================================

# ---------- Sistema operativo / editores ----------
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
.idea/
*.iml
.vscode/

# ---------- Secretos: NUNCA al repositorio ----------
# Firma de Android (keystore y contraseñas)
*.jks
*.keystore
*.p12
*.pfx
keystore.properties
signing.properties
secrets.properties

# Variables de entorno
.env
.env.*
!.env.example

# Firebase: google-services.json contiene claves del proyecto.
google-services.json
GoogleService-Info.plist
# Credenciales de cuenta de servicio (panel y scripts de carga)
serviceAccountKey*.json
*-firebase-adminsdk-*.json

# ---------- Android / Gradle ----------
.gradle/
.kotlin/
local.properties
*.hprof
build/
captures/
.externalNativeBuild/
.cxx/

# Artefactos de compilación (APK/AAB firmados incluidos)
*.apk
*.aab
*.ap_
*.dex
app/debug/
app/release/

# El wrapper SÍ se versiona: gradlew, gradlew.bat, gradle/wrapper/*

# ---------- Node (Firebase CLI y scripts de migración) ----------
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------- Firebase CLI: estado local, no configuración ----------
.firebase/
.firebaserc
*.log

# ---------- Python (scripts de migración del banco) ----------
__pycache__/
*.py[cod]
.venv/
venv/

# ---------- Salidas generadas (se regeneran con scripts/) ----------
# hosting_assets se reconstruye con scripts/build_asset_fase5.py
hosting_assets/
# Área de trabajo temporal
tmp/

# ---------- Clases Java y volcados de JVM ----------
*.class
hs_err_pid*
replay_pid*

# ---------- Cobertura / reportes ----------
*.ec
coverage/
build/reports/
